# Safe template only: blank values are intentionally unusable.
# Copy only the relevant settings to private environment files/secrets.
# Runtime/config loader does not exist yet (Phase 2); do not assume auto-loading.
NODE_ENV=development
# Database production/development URL name is proposed pending owner config contract.
DATABASE_URL=
# WORKFLOW Phase 4: separate DB per server worktree.
DATABASE_URL_TEST=
JWT_SECRET=
# Unique bot and webhook secret for each of dev/staging/production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Provider selection, licensing, endpoints, auth and models are BLOCKED.
MARKET_API_URL=
MARKET_API_KEY=
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
AI_MODEL_CONTEXT=
# Only this public URL belongs in client env; never expose secrets via VITE_*.
VITE_API_URL=
# Local testing only. REMOVE this setting entirely in production.
MARKET_FORCE_OPEN=false
# Payment variables are not specified until owner selects gateway + webhook contract.
